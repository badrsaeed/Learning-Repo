{
  "name": "viral-wave.angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --configuration=development",
    "start:testing": "ng serve --configuration=testing",
    "start:staging": "ng serve --configuration=staging",
    "build": "ng build",
    "build:local": "ng build --configuration=development",
    "build:testing": "ng build --configuration=testing && javascript-obfuscator ./dist/viral-wave.angular --output ./dist/viral-wave.angular",
    "build:staging": "ng build --configuration=staging && javascript-obfuscator ./dist/viral-wave.angular --output ./dist/viral-wave.angular",
    "build:prod": "ng build --configuration=production && javascript-obfuscator ./dist/viral-wave.angular --output ./dist/viral-wave.angular",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "postinstall": "npx --package @angular/compiler-cli@15.2.9 --yes ngcc"
  },
  "private": true,
